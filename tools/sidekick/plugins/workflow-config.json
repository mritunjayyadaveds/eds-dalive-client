{
  "workflow": {
    "enabled": true,
    "approvalSheet": "/approval-requests",
    "roles": {
      "authors": {
        "description": "Users who can edit content but cannot publish directly",
        "canEdit": true,
        "canPublish": false,
        "canRequestPublish": true
      },
      "approvers": {
        "description": "Users who can review and approve publish requests",
        "canEdit": true,
        "canPublish": true,
        "canApprove": true
      }
    },
    "users": {
      "authors": ["jatin.patel2@ibm.com"],
      "approvers": ["mritunjay.yadav@ibm.com"]
    },
    "permissions": {
      "source": "email-based",
      "note": "Roles are determined by email address. Authors can request publish, Approvers can approve and publish."
    },
    "statuses": {
      "pending": "Awaiting approval",
      "approved": "Approved and published",
      "rejected": "Changes rejected"
    }
  }
}
